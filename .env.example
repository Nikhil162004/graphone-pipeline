# Copy to .env and fill in what you have. The pipeline runs end-to-end with NO keys
# (deterministic grounded extraction); keys switch the LLM tiers on, in this order.
GEMINI_API_KEY=
[SECURITY_DATA]
DEEPSEEK_API_KEY=

# Optional: exact, fast GitHub star refreshes (REST). Without it, paper stars come
# from Hugging Face's recorded counts, which the pipeline spot-verifies.
GITHUB_TOKEN=

# LLM fallback chain order (any subset).
LLM_TIER_ORDER=gemini,groq,deepseek

# Politeness / scale knobs.
GLOBAL_CONCURRENCY=12
PER_HOST_CONCURRENCY=4
FRESHNESS_HOURS=24
SCRAPER_UA=FrontierAtlasBot/1.0 (+assessment; contact: you@example.com)
